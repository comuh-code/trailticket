<%= form_with url: ticket_details_path(ticket), method: :patch, class: 'tt-panel tt-details-form', data: { tt_details: true } do %>
  <h2><%= tt('details.title') %></h2>
  <% if ticket.needs_triage? %>
    <p class="tt-triage-hint" data-tt-triage-hint>
      <%= tt_icon(:warning) %>
      <span>
        <%= tt('triage.hint', status: status_label(Trailticket::Ticket.initial_status)) %>
        <% if ticket.suggested_priority %>
          <br><%= tt('triage.suggested', priority: priority_label(ticket.suggested_priority)) %>
        <% end %>
      </span>
    </p>
  <% end %>
  <label class="tt-field">
    <span><%= tt('fields.priority') %></span>
    <select name="priority">
      <% if ticket.priority.nil? %>
        <option value=""><%= tt('triage.choose') %></option>
      <% end %>
      <% Trailticket::Ticket::PRIORITIES.reverse_each do |priority| %>
        <option value="<%= priority %>" <%= 'selected' if ticket.priority == priority %>><%= priority_label(priority) %></option>
      <% end %>
    </select>
  </label>
  <label class="tt-field">
    <span><%= tt('fields.assignee') %></span>
    <select name="assignee">
      <option value=""><%= tt('details.nobody') %></option>
      <% options = assignee_options %>
      <% options += [ticket.assignee] if ticket.assignee && options.exclude?(ticket.assignee) %>
      <% options.each do |person| %>
        <option value="<%= assignee_key(person) %>" <%= 'selected' if person == ticket.assignee %>><%= author_label(person) %></option>
      <% end %>
    </select>
  </label>
  <button type="submit" class="tt-button tt-primary"><%= tt('details.save') %></button>
<% end %>
