<% content_for :title, tt('list') %>
<h1 class="tt-title"><%= tt('list') %></h1>

<%= form_with url: list_path, method: :get, class: 'tt-filters', role: 'search', skip_enforcing_utf8: true do %>
  <label class="tt-field tt-field-grow">
    <span><%= tt('search') %></span>
    <input type="search" name="q" value="<%= @filters[:q] %>" placeholder="<%= tt('search_placeholder') %>">
  </label>
  <label class="tt-field">
    <span><%= tt('fields.status') %></span>
    <select name="status">
      <option value=""><%= tt('any_status') %></option>
      <% Trailticket.config.statuses.each do |status| %>
        <option value="<%= status %>" <%= 'selected' if @filters[:status] == status %>><%= status_label(status) %></option>
      <% end %>
    </select>
  </label>
  <label class="tt-field">
    <span><%= tt('fields.priority') %></span>
    <select name="priority">
      <option value=""><%= tt('any_priority') %></option>
      <% Trailticket::Ticket::PRIORITIES.each do |priority| %>
        <option value="<%= priority %>" <%= 'selected' if @filters[:priority] == priority %>><%= priority_label(priority) %></option>
      <% end %>
    </select>
  </label>
  <label class="tt-field">
    <span><%= tt('archive.filter') %></span>
    <select name="archived">
      <option value=""><%= tt('archive.not_archived') %></option>
      <option value="only" <%= 'selected' if @filters[:archived] == 'only' %>><%= tt('archive.only') %></option>
      <option value="all" <%= 'selected' if @filters[:archived] == 'all' %>><%= tt('archive.all') %></option>
    </select>
  </label>
  <div class="tt-filter-actions">
    <button type="submit" class="tt-button tt-primary"><%= tt('filter') %></button>
    <%= link_to tt('clear'), list_path, class: 'tt-button' %>
  </div>
<% end %>

<p class="tt-muted" data-tt-total><%= tt('total', count: @total) %></p>

<% if @tickets.empty? %>
  <p class="tt-empty-state"><%= tt('no_results') %></p>
<% else %>
  <div class="tt-table-wrap">
    <table class="tt-table">
      <thead>
        <tr>
          <th scope="col"><%= tt('fields.id') %></th>
          <th scope="col"><%= tt('fields.title') %></th>
          <th scope="col"><%= tt('fields.status') %></th>
          <th scope="col"><%= tt('fields.priority') %></th>
          <th scope="col"><%= tt('fields.author') %></th>
          <th scope="col"><%= tt('fields.subject') %></th>
          <th scope="col"><%= tt('fields.created_at') %></th>
          <th scope="col"><%= tt('fields.updated_at') %></th>
        </tr>
      </thead>
      <tbody>
        <% @tickets.each do |ticket| %>
          <tr data-tt-row>
            <td class="tt-muted"><%= ticket.id %></td>
            <td><a href="<%= ticket_path(ticket) %>" data-tt-title><%= ticket.title %></a></td>
            <td><%= status_badge(ticket.status) %><% if ticket.archived? %> <span class="tt-badge" data-tt-archived><%= tt('archive.badge') %></span><% end %></td>
            <td><%= priority_badge(ticket.priority) %></td>
            <td><%= author_label(ticket.author) %></td>
            <td><%= subject_label(ticket.subject) %></td>
            <td><%= time_label(ticket.created_at) %></td>
            <td><%= time_label(ticket.updated_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if @pages > 1 %>
  <nav class="tt-pagination" aria-label="<%= tt('pagination') %>">
    <% query = @filters.compact_blank %>
    <% if @page > 1 %>
      <%= link_to tt('previous'), list_path(query.merge(page: @page - 1)), class: 'tt-button', rel: 'prev' %>
    <% end %>
    <span data-tt-page><%= tt('page', page: @page, pages: @pages) %></span>
    <% if @page < @pages %>
      <%= link_to tt('next'), list_path(query.merge(page: @page + 1)), class: 'tt-button', rel: 'next' %>
    <% end %>
  </nav>
<% end %>
